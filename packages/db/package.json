{
  "name": "@kuutti/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, generated migrations, the locked migrate runner, and the seed.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./demo": "./src/seed/demo.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "check": "drizzle-kit check",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/cli/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/cli/seed.ts",
    "moderator": "node --env-file-if-exists=../../.env --import tsx src/cli/moderator.ts"
  },
  "dependencies": {
    "@kuutti/schema": "workspace:*",
    "@kuutti/tunnistus-oidc": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
