{
  "name": "@kuutti/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Expo app. Routes under app/ stay thin; features live under src/features/<slice>/.",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "check:contrast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-contrast.ts",
    "licenses": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/licenses.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@formatjs/intl-locale": "5.3.12",
    "@formatjs/intl-pluralrules": "6.3.15",
    "@kuutti/i18n": "workspace:*",
    "@kuutti/schema": "workspace:*",
    "@rn-primitives/dialog": "1.5.2",
    "@rn-primitives/label": "1.5.2",
    "@rn-primitives/portal": "1.5.3",
    "@rn-primitives/slot": "1.5.2",
    "@rn-primitives/switch": "1.5.2",
    "@sentry/react-native": "~8.29.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "lucide-react-native": "1.52.0",
    "nativewind": "4.2.7",
    "openapi-fetch": "^0.17.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "catalog:",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "test-renderer": "^1.3.0",
    "typescript": "catalog:"
  }
