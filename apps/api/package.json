{
  "name": "@kuutti/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hono on Node. One process: HTTP routes, WebSockets, nightly jobs.",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "openapi": "node --import tsx scripts/openapi.ts",
    "demo:population": "node --env-file-if-exists=../../.env --import tsx scripts/demo-population.ts",
    "demo:reset": "node --env-file-if-exists=../../.env --import tsx scripts/demo-reset.ts",
    "demo:stories": "node --import tsx scripts/demo-stories.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1144.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/client-ssm": "^3.1144.0",
    "@aws-sdk/cloudfront-signer": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@kuutti/db": "workspace:*",
    "@kuutti/i18n": "workspace:*",
    "@kuutti/schema": "workspace:*",
    "@kuutti/tunnistus-oidc": "workspace:*",
    "@sentry/node": "^11.1.0",
    "blurhash": "^2.0.5",
    "hono": "^4.13.12",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
