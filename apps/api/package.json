{
  "name": "@kuutti/api",
  "version": "0.81.2",
  "private": true,
  "type": "module",
  "description": "Hono on Node. One process: HTTP routes, WebSockets, nightly jobs.",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsup && node scripts/notices.ts",
    "notices:libvips": "node scripts/notices-libvips.ts",
    "start": "node dist/index.js",
    "openapi": "node --import tsx scripts/openapi.ts",
    "demo:population": "node --env-file-if-exists=../../.env --import tsx scripts/demo-population.ts",
    "demo:reset": "node --env-file-if-exists=../../.env --import tsx scripts/demo-reset.ts",
    "demo:stories": "node --import tsx scripts/demo-stories.ts",
    "demo:assets": "node --import tsx scripts/demo-assets.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/client-sesv2": "3.1147.0",
    "@aws-sdk/client-ssm": "^3.1147.0",
    "@aws-sdk/cloudfront-signer": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@hono/node-server": "^2.1.3",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@kuutti/db": "workspace:*",
    "@kuutti/i18n": "workspace:*",
    "@kuutti/schema": "workspace:*",
    "@kuutti-ry/tunnistus-oidc": "^0.1.0",
    "@sentry/node": "^11.5.0",
    "blurhash": "^2.0.5",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "hyparquet": "1.31.4",
    "hyparquet-writer": "0.16.12",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "ws": "8.21.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kuutti/notices": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "^4.10.2",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.2.0",
    "smol-toml": "1.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
