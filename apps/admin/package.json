{
  "name": "@kuutti/admin",
  "version": "0.78.1",
  "private": true,
  "type": "module",
  "description": "Moderation panel. Vite + React, a static build behind CloudFront at admin.<domain>, previews under /pr-<n>/ (ADR-025).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node e2e/run.ts"
  },
  "dependencies": {
    "@kuutti/i18n": "workspace:*",
    "@kuutti/schema": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "openapi-fetch": "^0.17.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "^8.3.3",
    "vitest": "catalog:"
  }
}
