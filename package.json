{
  "name": "kuutti",
  "private": true,
  "version": "0.100.1",
  "type": "module",
  "description": "Kuutti monorepo root. Workspace members arrive with the M1 scaffold (#2).",
  "license": "SEE LICENSE IN LICENSE-EXCEPTION",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "dev": "pnpm --filter @kuutti/api dev",
    "env:up": "node --env-file-if-exists=.env scripts/dev-env.ts up",
    "env:down": "node --env-file-if-exists=.env scripts/dev-env.ts down",
    "env:status": "node --env-file-if-exists=.env scripts/dev-env.ts status",
    "env:doctor": "node scripts/doctor.ts",
    "fonts": "node scripts/fonts.ts",
    "aws:login": "infra/scripts/aws-login",
    "dev:mobile": "pnpm --filter @kuutti/mobile start",
    "dev:admin": "pnpm --filter @kuutti/admin dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check . && node scripts/check-fonts.ts && pnpm --filter @kuutti/i18n run check:ui-strings",
    "format": "biome format --write .",
    "knip": "knip",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "check:scenarios": "node scripts/check-scenarios.ts",
    "e2e": "node scripts/e2e.ts",
    "e2e:admin": "node apps/admin/e2e/run.ts",
    "load:smoke": "node scripts/load-smoke.ts",
    "i18n:build": "pnpm --filter @kuutti/i18n run build",
    "i18n:check": "pnpm --filter @kuutti/i18n run check",
    "i18n:translate": "pnpm --filter @kuutti/i18n translate",
    "i18n:review": "pnpm --filter @kuutti/i18n run review",
    "openapi": "pnpm --filter @kuutti/api openapi",
    "check:schema-words": "node scripts/check-schema-words.ts",
    "check:version": "node scripts/check-version.ts",
    "version:bump": "node scripts/bump-version.ts",
    "check:licenses": "node scripts/check-licenses.ts",
    "check:adr-index": "node scripts/check-adr-index.ts",
    "check:decisions": "node scripts/check-decisions.ts",
    "check:docs": "node scripts/check-docs.ts",
    "check:fonts": "node scripts/check-fonts.ts",
    "check:legal-versions": "node packages/i18n/scripts/check-legal-versions.ts",
    "demo:bank": "node packages/db/src/cli/demo-bank.ts",
    "demo:population": "pnpm --filter @kuutti/api run demo:population",
    "demo:reset": "pnpm --filter @kuutti/api run demo:reset",
    "demo:stories": "pnpm --filter @kuutti/api run demo:stories",
    "demo:assets": "pnpm --filter @kuutti/api run demo:assets",
    "places": "node scripts/places.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@kuutti-ry/tunnistus-oidc": "^0.1.1",
    "eas-cli": "26.0.0",
    "knip": "6.43.0",
    "yaml": "2.9.1"
  }
}
