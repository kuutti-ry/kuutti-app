# --- Secrets and local configuration: never commit these ---
.env
.env.*
!.env.example
*.pem
# The public half of a CloudFront signing key is declared in code (ADR-005 §3): committed, never private.
!infra/envs/*/cloudfront-signing-key.pub.pem
!infra/envs/*/cloudfront-signing-key.*.pub.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials*.json
service-account*.json
*.secret

# --- Dependencies ---
node_modules/
.pnpm-store/
vendor/

# --- Build output and coverage ---
dist/
build/
out/
.next/
.nuxt/
.output/
.svelte-kit/
coverage/

# --- Logs and caches ---
# What each request of an i18n:translate batch asked for, until it is collected (#55).
packages/i18n/.batches/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.turbo/
.eslintcache

# --- OS and editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.swp
*~

# --- Claude Code per-developer overrides (the shared settings.json is committed) ---
.claude/settings.local.json

# --- Expo and Metro ---
.expo/
.expo-shared/
*.jks
*.p8
*.mobileprovision
*.orig.*
web-build/
ios/
android/

# --- TypeScript build info ---
*.tsbuildinfo
expo-env.d.ts
.metro-health-check*
.kotlin/
.claude/session-handoff.md

# RDS root certificates for TLS verification (public, from the AWS truststore).
!apps/api/certs/rds-eu-central-1-bundle.pem
# Where a withdrawn update signing key (ADR-004) may still sit on a developer's machine.
apps/mobile/keys/

# --- End-to-end flows: the copy of the cached pictures scripts/e2e.ts makes ---
apps/mobile/e2e/media
